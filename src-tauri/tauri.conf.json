{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura MFT Lens",
  "version": "0.1.1",
  "identifier": "dev.aura.mftlens",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AURA / MFT LENS",
        "width": 1380,
        "height": 880,
        "minWidth": 1100,
        "minHeight": 740,
        "backgroundColor": "#100d18"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": false
  }
}
